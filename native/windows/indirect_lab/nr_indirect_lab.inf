[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%Provider%
CatalogFile=nr_indirect_lab.cat
DriverVer=10/10/2026,0.0.2.0
PnpLockDown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%Device%=Install,ROOT\NPURENDER_INDIRECT_LAB

[Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverCopy

[Install.NT.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=Hardware

[Hardware]
HKR,,UpperFilters,0x00010000,"IndirectKmd"
HKR,WUDF,DeviceGroupId,0x00000000,"NpuRenderDisposableIndirectLab"

[Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[Install.NT.Wdf]
UmdfService=nr_indirect_lab,Service
UmdfServiceOrder=nr_indirect_lab
UmdfKernelModeClientPolicy=AllowKernelModeClients

[Service]
UmdfLibraryVersion=2.25.0
ServiceBinary=%13%\nr_indirect_lab.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
DriverCopy=13

[DriverCopy]
nr_indirect_lab.dll

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
nr_indirect_lab.dll=1

[Strings]
Provider="t8"
Device="NPU Render Indirect Admission Lab (VM only)"
Disk="NPU Render Disposable Guest Laboratory"
