{
  "name": "Conventional Commits on every branch",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "Conventional Commit header",
        "negate": false,
        "operator": "regex",
        "pattern": "^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\\([^()\\r\\n]+\\))?!?: \\S[^\\r\\n]*"
      }
    }
  ]
}
