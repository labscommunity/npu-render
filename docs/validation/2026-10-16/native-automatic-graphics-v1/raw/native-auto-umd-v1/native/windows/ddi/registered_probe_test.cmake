# Exercise the actual executable and reports. A crash, missing DLL, or generic
# nonzero exit does not count as successful rejection of a foreign adapter.
execute_process(COMMAND "${PROBE}" --list RESULT_VARIABLE code OUTPUT_VARIABLE adapters)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Cannot enumerate adapters: ${code}")
endif()
string(JSON count LENGTH "${adapters}")
set(warp "")
if(count GREATER 0)
  math(EXPR last "${count} - 1")
  foreach(i RANGE ${last})
    string(JSON software GET "${adapters}" ${i} software)
    if(software)
      string(JSON warp GET "${adapters}" ${i} luid)
      break()
    endif()
  endforeach()
endif()
if(warp STREQUAL "")
  message(FATAL_ERROR "A software adapter is required for this rejection control")
endif()
foreach(case IN ITEMS foreign malformed)
  if(case STREQUAL "foreign")
    set(luid "${warp}")
    set(expected "selected adapter is not a ready NPU Render kernel adapter")
  else()
    set(luid "00000000:xyz00000")
    set(expected "invalid adapter LUID")
  endif()
  set(report "${REPORT_DIR}/registered-reject-${case}.json")
  file(REMOVE "${report}")
  execute_process(COMMAND "${PROBE}" "${UMD}" CPU "${report}" "${luid}" RESULT_VARIABLE code)
  if(NOT code EQUAL 1 OR NOT EXISTS "${report}")
    message(FATAL_ERROR "${case} did not produce a normal rejection report: ${code}")
  endif()
  file(READ "${report}" data)
  string(JSON error GET "${data}" error)
  if(NOT error STREQUAL expected)
    message(FATAL_ERROR "${case} rejected for unexpected reason: ${error}")
  endif()
  foreach(field IN ITEMS passed adapter_identity_confirmed device_creation_attempted)
    string(JSON value GET "${data}" ${field})
    if(value)
      message(FATAL_ERROR "${case} incorrectly reported ${field}")
    endif()
  endforeach()
  foreach(field IN ITEMS adapters devices executions software_thunk_calls)
    string(JSON value GET "${data}" stats ${field})
    if(NOT value EQUAL 0)
      message(FATAL_ERROR "${case} reached the renderer: ${field}=${value}")
    endif()
  endforeach()
endforeach()
