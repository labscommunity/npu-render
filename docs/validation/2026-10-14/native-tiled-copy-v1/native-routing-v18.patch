+     }
+    }
+    CHECK(result->covered==covered);std::printf("{\"crop_case\":true,\"milliseconds\":%.6f,\"provider_calls\":%u,\"width\":%u,\"height\":%u,\"swap\":%s,\"style\":%u,\"frame\":%u,\"error_bound\":%.9g,\"execution_device\":\"%s\"}\n",milliseconds,result->provider_calls,w,h,swap?"true":"false",style,frame,result->maximum_byte_error,result->device.c_str());std::fflush(stdout);
+   }
+  }
+ }
+ std::printf("{\"passed\":true,\"checked_components\":%llu,\"npu_or_cpu_crop_calls\":%llu,\"negative_cases\":%u,\"maximum_oracle_error\":%.9g,\"execution_device\":\"%s\",\"desktop_offloaded\":false}\n",static_cast<unsigned long long>(checked),static_cast<unsigned long long>(calls),rejected,maximum,backend.c_str());return 0;
+}catch(const std::exception &e){std::fprintf(stderr,"%s\n",e.what());return 1;}
