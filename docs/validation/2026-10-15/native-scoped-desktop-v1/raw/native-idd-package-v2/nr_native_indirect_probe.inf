[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%Provider%
CatalogFile=nr_native_indirect_probe.cat
DriverVer=10/15/2026,0.0.1502.0
PnpLockDown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%Device%=Install,ROOT\NPURENDER_NATIVE_INDIRECT_V1

[Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverCopy

[Install.NT.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=Hardware

[Hardware]
HKR,,UpperFilters,0x00010000,"IndirectKmd"
HKR,WUDF,DeviceGroupId,0x00000000,"T8NativeIddV1"

[Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[Install.NT.Wdf]
UmdfService=nr_native_indirect_probe,Service
UmdfServiceOrder=nr_native_indirect_probe
UmdfKernelModeClientPolicy=AllowKernelModeClients

[Service]
UmdfLibraryVersion=2.25.0
ServiceBinary=%13%\nr_native_indirect_probe.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
DriverCopy=13

[DriverCopy]
nr_native_indirect_probe.dll

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
nr_native_indirect_probe.dll=1

[Strings]
Provider="t8"
Device="NPU Render Bounded Native Indirect Probe"
Disk="NPU Render Native Indirect Diagnostic"
