+// Replay one recorded general-texture draw directly on an explicit provider.
+// This diagnostic does not admit a desktop, change routing, or display pixels.
+#include "indexed_exchange_protocol.hpp"
+#include "provider_compile_statistics.hpp"
+#include <chrono>
+#include <fstream>
+#include <cstdio>
+namespace ex=nr::registered_lab::indexed_exchange;
+int main(int argc,char **argv)try{
+ ex::require(argc==4);const std::string device(argv[2]);ex::require(device=="CPU" || device=="NPU");
+ std::ifstream file(argv[1],std::ios::binary|std::ios::ate);ex::require(bool(file));const auto length=file.tellg();
+ ex::require(length>=80 && length<=ex::max_packet_bytes);file.seekg(0);std::vector<uint8_t> bytes(size_t(length),0);
+ file.read(reinterpret_cast<char*>(bytes.data()),length);ex::require(bool(file));const auto request=ex::decode(bytes);const auto &h=request.header;
+ ex::require((h.flags&0x2000) && h.vertices && h.vertices<=4095 && !(h.vertices%3));
+ uint32_t capacity=3;while(capacity<h.vertices)capacity=(std::min)(4095u,capacity*2);
+ const auto batch=ex::triangle_batch(request,nr::shader::RegisterExecutor::preferred_raster_batch(request.pixel));
+ const auto start=std::chrono::steady_clock::now();
+ nr::raster::TriangleTextureDrawExecutor executor(request.vertex,request.pixel,capacity,h.width,h.height,h.format,
+   request.resources,request.samplers,device,ex::blend_mode(h),uint8_t((h.flags>>8)&15),static_cast<nr::raster::CullMode>((h.flags>>5)&3),(h.flags&128)!=0,batch);
+ const auto result=executor.execute(request.inputs,request.vertex_constants,request.pixel_constants,request.viewport,
+   request.resources,request.background,request.scissor,request.blend_constant);
+ ex::require(result.execution_device==device && result.pixels.size()==size_t(h.width)*h.height);
+ std::ifstream exists(argv[3],std::ios::binary);ex::require(!exists);exists.close();
+ std::ofstream output(argv[3],std::ios::binary);ex::require(bool(output));output.write(reinterpret_cast<const char*>(result.pixels.data()),std::streamsize(result.pixels.size()*4));output.close();ex::require(bool(output));
+ const auto elapsed=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count();
+ std::printf("{\"recorded_draw_diagnostic\":true,\"execution_device\":\"%s\",\"width\":%u,\"height\":%u,\"vertex_capacity\":%u,\"batch\":%u,\"pixel_bytes\":%llu,\"provider_requests\":%llu,\"draw_ms\":%.3f,\"compile_and_draw_ms\":%.3f,\"desktop_changed\":false,\"passed\":true}\n",
+  device.c_str(),h.width,h.height,capacity,batch,static_cast<unsigned long long>(result.pixels.size()*4),static_cast<unsigned long long>(result.provider_requests),result.timings.total_ms,elapsed);
+ return 0;
+}catch(const std::exception &error){std::fprintf(stderr,"%s\n",error.what());return 1;}
