+  constants[0][0].fill(as_bits(7.f));
+  for(unsigned tile=0;tile<4;++tile){
+   for(unsigned n=0;n<input.size();++n){input[n][0]={as_bits((float((n+tile)%4)+.5f)/4),as_bits((float((n/4+tile)%4)+.5f)/4),0,0};
+    for(unsigned c=0;c<4;++c)input[n][1][c]=as_bits(float((n+c+tile)%8)/32);}
+   const auto result=executor.execute_prepared(input);verify(result,p,input,captured_constants,shapes,samplers,captured_image,backend);verified+=256;
+   if(!input_bytes){input_bytes=result.input_bytes;output_bytes=result.output_bytes;}
+   TEST(result.input_bytes==input_bytes && result.output_bytes==output_bytes);
+   if(!tile){image={};constants={};}
+  }
+  // The ordinary API must refresh all bindings and still produce the oracle.
+  const auto ordinary=executor.execute(input,captured_constants,captured_image);
+  verify(ordinary,p,input,captured_constants,shapes,samplers,captured_image,backend);verified+=256;
+  TEST(ordinary.input_bytes==input_bytes && ordinary.output_bytes==output_bytes);
+  rejects([&]{executor.prepare_inputs({},captured_image);});
+  rejects([&]{(void)executor.execute_prepared(input);});
+  executor.prepare_inputs(captured_constants,captured_image);
+  verify(executor.execute_prepared(input),p,input,captured_constants,shapes,samplers,captured_image,backend);verified+=256;
+ }
+ // A malformed texture upload fails closed; no stale prepared result is usable.
+ VertexConstants constants;constants[0].resize(1);TexturePixels malformed;
+ rejects([&]{executor.prepare_inputs(constants,malformed);});
+ rejects([&]{(void)executor.execute_prepared(input);});
+ rejects([&]{executor.prepare_inputs(constants,malformed);});
