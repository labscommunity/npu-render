+}
+void integer_constants(const std::string &backend){
+ Program p;p.stage=Stage::pixel;p.inputs[0]=p.outputs[0]=15;p.constants[0]=1;
+ Instruction i;i.opcode=Opcode::bitwise_or;i.destination.kind=Register::output;i.destination.mask=15;i.source_count=2;
+ i.sources[0].kind=Register::input;i.sources[1].kind=Register::constant;p.instructions.push_back(i);
+ PixelExecutor executor(p,64,backend);std::vector<VertexRegisters> input(64);unsigned verified=0;
+ for(unsigned draw=0;draw<3;++draw){
