+uint8_t quantize(float v){v=(std::max)(0.f,(std::min)(255.f,v));const auto n=uint32_t(v);const auto fraction=v-float(n);return uint8_t(n+uint32_t(fraction>.5f || (fraction==.5f && (n&1))));}
