+int64_t edge(Point a,Point b,Point p){return (int64_t(b[0])-a[0])*(int64_t(p[1])-a[1])-(int64_t(b[1])-a[1])*(int64_t(p[0])-a[0]);}
+bool covered(Sample sample,const std::array<int32_t,4> &clip,CullMode cull,bool ccw){
+    auto &v=sample.triangle;const auto area=edge(v[0],v[1],v[2]);if(!area)return false;
