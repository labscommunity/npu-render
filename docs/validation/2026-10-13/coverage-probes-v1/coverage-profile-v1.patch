+    if((cull==CullMode::back && !front) || (cull==CullMode::front && front))return false;
+    if(sample.point[0]<clip[0] || sample.point[1]<clip[1] || sample.point[0]>=clip[2] || sample.point[1]>=clip[3])return false;
+    if(area<0)std::swap(v[1],v[2]);
+    for(unsigned i=0;i<3;++i){const auto a=v[i],b=v[(i+1)%3];const auto e=edge(a,b,sample.point);const bool top=b[1]<a[1] || (b[1]==a[1] && b[0]>a[0]);if(e<0 || (!e && !top))return false;}
