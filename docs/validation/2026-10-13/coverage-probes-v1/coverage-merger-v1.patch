+// Isolated experiment: exact existing coverage and merger graphs joined without
+// publishing the coverage tensor to the host between provider executions.
+class FusedCoverageMerger {
+    uint32_t count;
+    BlendMode blend;
+    ov::Core core;
+    ov::CompiledModel compiled;
+    ov::InferRequest request;
+    std::string device;
