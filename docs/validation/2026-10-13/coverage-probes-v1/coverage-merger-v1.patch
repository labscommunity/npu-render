+public:
+    struct Result {std::vector<PackedColor> pixels;std::vector<uint8_t> covered;std::string execution_device;};
+    FusedCoverageMerger(uint32_t samples,const std::string &backend,BlendMode mode,bool bgra,uint8_t mask,CullMode cull,bool front_ccw)
+        :count(samples),blend(mode){
+        require(backend=="CPU" || backend=="GPU" || backend=="NPU");
+        auto coverage=make_coverage_model(count,cull,front_ccw);
+        auto merger=make_output_merger_model(count,blend,bgra,mask);
+        auto parameters=coverage->get_parameters();bool joined=false;
+        for(const auto &parameter:merger->get_parameters()){
+            if(parameter->output(0).get_names().count("coverage")){
+                parameter->output(0).replace(coverage->get_results()[0]->input_value(0));joined=true;
+            }else parameters.push_back(parameter);
+        }
+        require(joined);
+        auto model=std::make_shared<ov::Model>(ov::OutputVector{merger->get_results()[0]->input_value(0),coverage->get_results()[0]->input_value(0)},parameters);
+        ov::AnyMap properties{ov::hint::performance_mode(ov::hint::PerformanceMode::LATENCY)};
+        if(backend=="NPU"){
+            for(const auto &node:model->get_ops())node->get_rt_info()["precise_0"]=std::string{};
+            std::ostringstream xml,weights;ov::pass::Serialize serializer(xml,weights);serializer.run_on_model(model);
+            const auto bytes=weights.str();ov::Tensor data(ov::element::u8,ov::Shape{bytes.size()});
+            if(!bytes.empty())std::memcpy(data.data(),bytes.data(),bytes.size());
+            model=core.read_model(xml.str(),data);
+            for(const auto &node:model->get_ops())require(nr::provider::precision_preserved(node));
+            properties.emplace(ov::hint::execution_mode(ov::hint::ExecutionMode::ACCURACY));
+        }
+        compiled=nr::provider::compile_model(core,model,backend,properties);
+        const auto devices=compiled.get_property(ov::execution_devices);
+        require(devices.size()==1 && (devices[0]==backend || devices[0].rfind(backend+".",0)==0));device=devices[0];request=compiled.create_infer_request();
+    }
+    Result execute(const std::vector<Sample> &samples,const std::array<int32_t,4> &clip,
+        const std::vector<Color> &colors,const std::vector<PackedColor> &background,const Color &constant){
+        require(!failed && samples.size()==count && colors.size()==count && background.size()==count);
+        require(clip[0]<=clip[2] && clip[1]<=clip[3]);
+        for(const auto value:clip)require(value>=-coordinate_limit && value<=coordinate_limit+1);
+        for(const auto &sample:samples){
+            for(const auto &point:sample.triangle)for(const auto value:point)require(value>=-coordinate_limit && value<=coordinate_limit);
+            for(const auto value:sample.point)require(value>=-coordinate_limit && value<=coordinate_limit);
+        }
+        for(const auto &color:colors)for(const auto value:color)require(std::isfinite(value) && std::abs(value)<=16);
+        for(const auto value:constant)require(std::isfinite(value));
+        failed=true;
+        auto vertices=request.get_tensor("vertices"),points=request.get_tensor("points");
+        for(size_t i=0;i<count;++i){
+            std::memcpy(vertices.data<int32_t>()+i*6,samples[i].triangle.data(),24);
+            std::memcpy(points.data<int32_t>()+i*2,samples[i].point.data(),8);
+        }
+        std::memcpy(request.get_tensor("scissor").data<int32_t>(),clip.data(),16);
+        std::memcpy(request.get_tensor("colors").data<float>(),colors.data(),size_t(count)*16);
+        std::memcpy(request.get_tensor("background").data<uint8_t>(),background.data(),size_t(count)*4);
+        if(blend==BlendMode::component_coverage)std::memcpy(request.get_tensor("blend_constant").data<float>(),constant.data(),16);
+        request.infer();const auto pixels=request.get_output_tensor(0),coverage=request.get_output_tensor(1);
+        require(pixels.get_element_type()==ov::element::u8 && pixels.get_size()==size_t(count)*4);
+        require(coverage.get_element_type()==ov::element::i32 && coverage.get_size()==count);
+        Result result{{},{},device};result.pixels.resize(count);result.covered.resize(count);
+        std::memcpy(result.pixels.data(),pixels.data<const uint8_t>(),size_t(count)*4);
+        for(size_t i=0;i<count;++i){const auto value=coverage.data<const int32_t>()[i];require(value==0 || value==1);result.covered[i]=uint8_t(value);}
+        failed=false;return result;
+    }
+};
+}
