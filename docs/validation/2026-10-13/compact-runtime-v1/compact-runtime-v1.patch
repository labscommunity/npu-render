+        if(bits)while(!(bits&1)){bits>>=1;++shift;}
+        const int64_t divisor=int64_t(1)<<shift;for(auto &value:d)value/=divisor;
+        const auto bounds=std::minmax_element(d.begin(),d.end());if(*bounds.second-*bounds.first>4095)return false;
